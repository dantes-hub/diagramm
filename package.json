{
  "name": "processflow",
  "version": "1.0.0",
  "private": true,
  "description": "Turn compliance documents and SOPs into editable process diagrams using AI extraction.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "eval:extraction": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/evaluate-extraction.mts",
    "validate:bpmn": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/validate-bpmn-export.mts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@prisma/client": "^6.6.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@xyflow/react": "^12.8.5",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "openai": "^6.33.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
